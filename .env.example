# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_sdlc?retryWrites=true&w=majority

# Backend
# Port the backend process binds (0.0.0.0:$PORT). Defaults to 8000 for local Docker.
PORT=8000
JWT_SECRET=<your_long_random_secret>
JWT_EXPIRES_SECONDS=3600
# OAuth state nonce lifetime in seconds
OAUTH_STATE_TTL_SECONDS=600

# GitHub OAuth
GITHUB_CLIENT_ID=<github_client_id>
GITHUB_CLIENT_SECRET=<github_client_secret>
# Browser lands on the frontend Sign-in callback, which exchanges the code with the backend.
GITHUB_OAUTH_CALLBACK_URL=http://localhost:5173/login/callback

# GitHub Webhooks
# Use the same secret configured in GitHub webhook settings.
GITHUB_WEBHOOK_SECRET=<webhook_secret>

# Gemini
GEMINI_API_KEY=<your_gemini_api_key>
GEMINI_MODEL=gemini-flash-lite-latest

# AI Review (Phase 4)
# Severity formula: S = (Wsec * P) + (Wcomp * C) + (Whist * H)
SEVERITY_HEURISTIC_SEC_WEIGHT=0.6
SEVERITY_HEURISTIC_COMPLEXITY_WEIGHT=0.3
SEVERITY_HISTORY_WEIGHT=0.1
# Review bounds
REVIEW_MAX_FILES=30
REVIEW_MAX_FILE_CHARS=20000
REVIEW_MAX_DIFF_CHARS=150000

# Documentation generation (Phase 1)
# Bound on repository files scanned and source supplied to the model.
DOC_MAX_FILES=16
DOC_MAX_FILE_CHARS=6000
DOC_MAX_CODE_CHARS=50000

# CORS
CORS_ORIGINS=http://localhost:5173

# Frontend
# Base URL of the backend API as seen from the browser.
VITE_API_BASE_URL=http://localhost:8000

